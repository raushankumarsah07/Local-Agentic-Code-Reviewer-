# Application Configuration
APP_NAME="Local Agentic Code Reviewer and Architecture Grapher"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS settings (allowed frontend origins, JSON array format or comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Ingestion Limits
WORKSPACE_DIR=workspace
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_COUNT=5000

# Database Configuration (Switchable to PostgreSQL by changing URL)
DATABASE_URL=sqlite:///./app_data/app.db

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_db

# Local Ollama LLM Configuration (Set these to match your local setup)
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
